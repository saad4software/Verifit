# ==========================================
# Verifit Environment Variables Template
# Copy this file to .env.local and fill in your values
# ==========================================

# ------------------------------------------
# 1. Application Configuration
# ------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"

# ------------------------------------------
# 2. Database (hosted Turso SQLite)
# ------------------------------------------
# Required for development and production:
TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Optional: separate disposable Turso database for browser tests.
# TEST_TURSO_DATABASE_URL="libsql://your-test-db.turso.io"
# TEST_TURSO_AUTH_TOKEN="your-test-db-token"

# ------------------------------------------
# 3. Authentication (Better Auth)
# ------------------------------------------
# Generate a secure 32+ character random string (e.g. `openssl rand -hex 32`)
BETTER_AUTH_SECRET="your-32-character-secret-key-goes-here-12345678"
# Optional: comma-separated list of additional trusted origins (e.g. custom staging or production domains)
# BETTER_AUTH_TRUSTED_ORIGINS="https://example.com,https://staging.example.com"

# ------------------------------------------
# 4. Sanity CMS Configuration (Public / Studio)
# ------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID="your-sanity-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-09-19"

# ------------------------------------------
# 5. Sanity Server & AI Agent Credentials (Private)
# ------------------------------------------
# Required for server-side CV mutations and Sanity Agent Actions.
# Generate in Sanity Manage (https://www.sanity.io/manage) -> API -> Tokens (Editor/Write permissions)
SANITY_API_TOKEN="your-sanity-write-token"

# Deploy the Studio schema with `npx sanity schemas deploy`, then copy its ID
# from `npx sanity schemas list`. Redeploy after changing CV schema types.
SANITY_AGENT_SCHEMA_ID="your-deployed-schema-id"

# Deploy the schema including jdGeneration and jdSupport before enabling JD generation.
SANITY_JD_AGENT_SCHEMA_ID="your-deployed-jd-schema-id"

# Matching uses a separately tagged deployment so existing extraction schemas stay unchanged.
# npx sanity schemas deploy --tag matching-v1
# Copy the deployed ID containing matchAssessment into this setting.
SANITY_MATCH_AGENT_SCHEMA_ID="your-deployed-matching-schema-id"

# Optional: Dedicated schema ID for application CV tailoring and cover letter generation.
# If omitted, falls back to SANITY_AGENT_SCHEMA_ID. Deploy with `npx sanity schemas deploy`.
SANITY_APPLICATION_AGENT_SCHEMA_ID="your-deployed-schema-id"

